---
import { Icon } from 'astro-icon/components';

/**
 * The spine does not stop at the last entry — it fades out through
 * progressively fainter dots into a single pulsing marker. The point is that
 * the timeline is unfinished, not that it ended.
 */
---

<div class="terminus" data-terminus>
  <div class="terminus-trail" aria-hidden="true">
    <span class="trail-dot" style="--d: 0"></span>
    <span class="trail-dot" style="--d: 1"></span>
    <span class="trail-dot" style="--d: 2"></span>
  </div>

  <div class="terminus-head">
    <span class="terminus-pulse" aria-hidden="true"></span>

    <div class="terminus-copy">
      {/* "The story continues" only parses once you have read the story. In
          newest-first the terminus sits above everything, so it needs a label
          that works as an opening rather than a closing. */}
      <p class="terminus-title mono">
        <span data-label="oldest">The story continues</span>
        <span data-label="newest">What's next</span>
      </p>
      <p class="terminus-text">
        Looking for the next problem worth solving — ideally one where performance,
        correctness and constraints all actually matter.
      </p>
      <a class="terminus-cta" href="#contact">
        Get in touch
        <Icon name="lucide:arrow-right" width="15" height="15" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>

<style>
  .terminus {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-top: var(--space-4);
  }

  /* Newest-first puts the present at the top, so the terminus sits above the
     entries and its two halves swap: marker first, then the trail descending
     back toward recorded history. */
  .terminus[data-order='newest'] {
    flex-direction: column-reverse;
    padding-top: 0;
    padding-bottom: var(--space-4);
  }

  /* --- Fading trail of dots down the rail --- */

  .terminus-trail {
    position: relative;
    height: 5.5rem;
  }

  .trail-dot {
    position: absolute;
    left: calc(var(--rail-x) - var(--rail-pad) - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    /* Accent, not grey: these read as the rail carrying on rather than as
       leftover punctuation. Each is fainter than the last. */
    background: var(--accent);
    top: calc(var(--d) * 1.7rem + 0.6rem);
    /* Held in a variable so the keyframes and the reversed mode below can both
       reference one base value instead of repeating the arithmetic. */
    --o: calc(0.62 - var(--d) * 0.17);
    opacity: var(--o);
    animation: drift 3s var(--ease-inout) infinite;
    animation-delay: calc(var(--d) * 260ms);
  }

  /* Flipped: the strongest dot is the one nearest the entries, which is now the
     bottom of the trail rather than the top. */
  .terminus[data-order='newest'] .trail-dot {
    --o: calc(0.62 - (2 - var(--d)) * 0.17);
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(0);
      opacity: var(--o);
    }
    50% {
      transform: translateY(3px);
      opacity: calc(var(--o) + 0.33);
    }
  }

  /* --- The live marker --- */

  .terminus-head {
    position: relative;
    padding-left: 0;
  }

  .terminus-pulse {
    position: absolute;
    left: calc(var(--rail-x) - var(--rail-pad) - 0.375rem);
    top: 0.35rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .terminus-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: expand 2.8s var(--ease-inout) infinite;
  }

  @keyframes expand {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    75%,
    100% {
      transform: scale(3.4);
      opacity: 0;
    }
  }

  .terminus-copy {
    max-width: 44ch;
  }

  /* Default (and no-JS) state is oldest-first, so the newest-first label stays
     out of the document until the order actually flips. */
  .terminus-title [data-label='newest'] {
    display: none;
  }

  .terminus[data-order='newest'] .terminus-title [data-label='newest'] {
    display: inline;
  }

  .terminus[data-order='newest'] .terminus-title [data-label='oldest'] {
    display: none;
  }

  .terminus-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .terminus-text {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .terminus-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    padding: 0.6rem 1.1rem;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: var(--text-sm);
    font-weight: 580;
    transition:
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .terminus-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .terminus-cta [data-icon] {
    transition: transform var(--dur) var(--ease);
  }

  .terminus-cta:hover [data-icon] {
    transform: translateX(3px);
  }
</style>
