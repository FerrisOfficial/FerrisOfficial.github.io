---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../site';
import portrait from '../assets/portrait.png';

const heroLinks = [
  { label: 'View my work', href: '#experience', icon: 'lucide:arrow-right' },
  { label: 'GitHub', href: site.github, icon: 'lucide:github', external: true },
  { label: 'LinkedIn', href: site.linkedin, icon: 'lucide:linkedin', external: true },
  { label: 'Download CV', href: '/cv.pdf', icon: 'lucide:download', download: true },
] as const;
---

<section class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <p class="hero-status" style="--i: 0">
        <span class="status-dot" aria-hidden="true"></span>
        Open to opportunities · {site.location}
      </p>

      <h1 class="hero-name" style="--i: 1">{site.name}</h1>

      {/* The full string is always in the DOM — only its reveal is animated — so
          screen readers and crawlers get the role immediately. */}
      <p class="hero-role mono" style="--i: 2">
        <span class="typing" style={`--chars: ${site.role.length}`}>{site.role}</span>
      </p>

      <p class="hero-blurb" style="--i: 3">{site.tagline}</p>

      <p class="hero-stack mono" style="--i: 4">
        {site.stack.join(' · ')}
      </p>

      <ul class="hero-links" role="list" style="--i: 5">
        {
          heroLinks.map((link, index) => (
            <li>
              <a
                class="hero-link"
                data-primary={index === 0 ? '' : undefined}
                href={link.href}
                rel={link.external ? 'noopener noreferrer' : undefined}
                target={link.external ? '_blank' : undefined}
                download={link.download ? true : undefined}
              >
                <Icon name={link.icon} width="16" height="16" aria-hidden="true" />
                <span>{link.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <a class="hero-cue" href="#experience" style="--i: 6">
        <span>The story, in order</span>
        <Icon name="lucide:arrow-down" width="15" height="15" aria-hidden="true" />
      </a>
    </div>

    <div class="hero-portrait" style="--i: 1" aria-hidden="true">
      <Image class="hero-portrait-img" src={portrait} alt="" width={300} height={450} priority />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(88svh, 52rem);
    padding-block: var(--space-9) var(--space-8);
    overflow: hidden;
  }

  /* Static wash of accent behind the name. No animation — it is scenery.
     Centred on the text column rather than the viewport: the content is
     left-aligned, so a viewport-centred glow drifts off to one side of the
     name. The max() mirrors .container's centring, so it tracks the content
     at every width. */
  .hero-glow {
    position: absolute;
    /* translate -50% on both axes means top/left place the glow's *centre*,
       not its corner — so the bright core lands on a known point instead of
       depending on the circle's size. A rem offset also keeps it put when the
       hero's height changes; the old percentage made it drift. */
    top: 22em;
    left: calc(max(0px, (100% - var(--container)) / 2) + 13rem);
    width: min(46rem, 130%);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 14%, transparent) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-7);
  }

  .hero-text {
    min-width: 0;
  }

  .hero-portrait {
    justify-self: end;
    width: min(19rem, 42vw);
    animation: rise 0.9s var(--ease) backwards;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }

  .hero-portrait-img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 40px rgb(16 16 24 / 0.22));
  }

  /* Shared entrance: each child sets --i for its place in the stagger. */
  .hero-status,
  .hero-name,
  .hero-role,
  .hero-blurb,
  .hero-stack,
  .hero-links,
  .hero-cue {
    animation: rise 0.75s var(--ease) backwards;
    animation-delay: calc(var(--i) * 90ms + 60ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-muted);
  }

  .status-dot {
    position: relative;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: ping 2.4s var(--ease-inout) infinite;
  }

  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero-name {
    font-size: var(--text-3xl);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .hero-role {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  /* Typewriter.
     The text is monospace, so 1ch is exactly one glyph and the final width is
     just character count — no measuring needed. steps() makes the reveal land
     glyph by glyph instead of sliding smoothly.
     content-box matters: the global border-box reset would otherwise make the
     caret border eat into the width and clip the last character. */
  .typing {
    display: inline-block;
    box-sizing: content-box;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    border-right: 0.5em solid currentColor;
    width: calc(var(--chars) * 1ch);
  }

  /* Declared only when motion is welcome, so reduced-motion users simply get
     the finished line with a static cursor.

     `backwards` rather than `forwards`, and the 0-width lives in the keyframes
     rather than on the element: the resting state is the *finished* line, so
     the animation only ever hides the text temporarily. Do it the other way
     round and anything that stops the animation running leaves the role
     permanently invisible. */
  @media (prefers-reduced-motion: no-preference) {
    .typing {
      animation:
        type 1.35s steps(var(--chars), end) 0.5s backwards,
        caret 1.1s steps(1, end) 1.95s infinite;
    }
  }

  @keyframes type {
    from {
      width: 0;
    }
    to {
      width: calc(var(--chars) * 1ch);
    }
  }

  @keyframes caret {
    50% {
      border-right-color: transparent;
    }
  }

  .hero-blurb {
    max-width: 46ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .hero-stack {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--text-faint);
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 520;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .hero-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .hero-link[data-primary] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }

  .hero-link[data-primary]:hover {
    border-color: var(--accent-hover);
    background: var(--accent-hover);
    color: var(--accent-contrast);
    box-shadow: var(--shadow-md);
  }

  .hero-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease);
  }

  .hero-cue:hover {
    color: var(--accent);
  }

  .hero-cue [data-icon] {
    animation: nudge 2.6s var(--ease-inout) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: auto;
      padding-block: var(--space-7) var(--space-8);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero-portrait {
      justify-self: end;
      width: min(10rem, 42vw);
      margin-top: calc(-1 * var(--space-4));
    }

    .hero-cue {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .hero-blurb {
      margin-top: var(--space-4);
      line-height: var(--leading-normal);
    }

    .hero-links {
      margin-top: var(--space-5);
    }
  }
</style>
