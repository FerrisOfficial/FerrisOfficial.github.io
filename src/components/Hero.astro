---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../site';
import portrait from '../assets/portrait.png';

type HeroLink = {
  label: string;
  href: string;
  icon: string;
  kind: 'primary' | 'secondary' | 'text';
  external?: boolean;
  download?: boolean;
};

const primaryLinks: HeroLink[] = [
  { label: 'Run C++ demo', href: '#catan-demo', icon: 'lucide:play', kind: 'primary' },
  { label: 'Experience', href: '#experience', icon: 'lucide:briefcase-business', kind: 'secondary' },
  { label: 'CV', href: '/cv.pdf', icon: 'lucide:download', download: true, kind: 'secondary' },
];

const socialLinks: HeroLink[] = [
  { label: 'GitHub', href: site.github, icon: 'lucide:github', external: true, kind: 'text' },
  { label: 'LinkedIn', href: site.linkedin, icon: 'lucide:linkedin', external: true, kind: 'text' },
];

const roleBreakIndex = site.role.indexOf(' — ');
const roleLead = roleBreakIndex >= 0 ? site.role.slice(0, roleBreakIndex) : site.role;
const roleDetail = roleBreakIndex >= 0 ? site.role.slice(roleBreakIndex) : '';
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1 class="hero-name" style="--i: 1">{site.name}</h1>

      <p class="hero-role mono" style="--i: 2">
        <span class="visually-hidden">{site.role}</span>
        <span class="typing" data-typing-text={site.role} aria-hidden="true">
          <span class="typing-output" data-typing-output>
            <span data-typing-lead>{roleLead}</span><br class="typing-break" /><span
              data-typing-detail>{roleDetail}</span
            >
          </span><span
            class="typing-cursor"
            aria-hidden="true"></span>
        </span>
      </p>

      <div class="hero-portrait hero-portrait-mobile" style="--i: 2" aria-hidden="true">
        <div class="hero-portrait-frame">
          <Image class="hero-portrait-img" src={portrait} alt="" width={300} height={450} priority />
        </div>
      </div>

      <p class="hero-blurb" style="--i: 3">{site.tagline}</p>

      <div class="hero-actions" style="--i: 5">
        <ul class="hero-links hero-primary" role="list" aria-label="Portfolio actions">
          {
            primaryLinks.map((link) => (
              <li>
                <a
                  class="hero-link"
                  data-kind={link.kind}
                  href={link.href}
                  download={link.download ? true : undefined}
                >
                  <Icon name={link.icon} width="16" height="16" aria-hidden="true" />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="hero-links hero-social" role="list" aria-label="Social profiles">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  class="hero-link"
                  data-kind="text"
                  href={link.href}
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <Icon name={link.icon} width="16" height="16" aria-hidden="true" />
                  <span>{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="hero-mobility mono" style="--i: 6">
        <Icon name="lucide:map-pin" width="14" height="14" aria-hidden="true" />
        <span class="hero-mobility-copy">
          <span>{site.location} · EU citizen</span><span class="hero-relocation"
            ><span class="hero-mobility-separator" aria-hidden="true"> · </span>Open to relocation
            across the EU</span
          >
        </span>
      </p>

    </div>

    <div class="hero-portrait hero-portrait-desktop" style="--i: 1" aria-hidden="true">
      <Image class="hero-portrait-img" src={portrait} alt="" width={300} height={450} priority />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(68svh, 38rem);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-7);
  }

  .hero-text {
    min-width: 0;
  }

  .hero-portrait {
    position: relative;
    justify-self: end;
    width: min(16rem, 36vw);
  }

  .hero-portrait-img {
    width: 100%;
    height: auto;
    filter: none;
  }

  .hero-portrait-mobile {
    display: none;
  }

  @media (min-width: 48.01rem) {
    .hero-portrait-desktop {
      display: grid;
      align-items: end;
      height: min(20rem, 31vw);
      overflow: clip;
      border: 1px solid color-mix(in srgb, var(--accent) 14%, var(--border));
      border-radius: 1.5rem 1.5rem var(--r-md) var(--r-md);
      background:
        radial-gradient(circle at 50% 22%, color-mix(in srgb, var(--surface) 70%, transparent), transparent 42%),
        color-mix(in srgb, var(--accent-soft) 42%, var(--surface));
      box-shadow: var(--shadow-md);
    }

    .hero-portrait-desktop .hero-portrait-img {
      align-self: end;
      transform: translateY(0.45rem) scale(1.035);
      transform-origin: center bottom;
    }
  }

  .hero-mobility {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .hero-name {
    font-size: var(--text-3xl);
    font-weight: 680;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .hero-role {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.35;
    color: var(--accent);
    letter-spacing: -0.01em;
  }

  .typing {
    display: inline;
    white-space: normal;
  }

  .typing-output {
    white-space: normal;
  }

  .typing-break {
    display: none;
  }

  .typing-cursor {
    display: inline-block;
    width: 0.45ch;
    height: 1em;
    margin-left: 0.08em;
    border-right: 0.14em solid currentColor;
    vertical-align: -0.12em;
    animation: caret-blink 0.75s steps(1, end) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .typing-cursor {
      display: none;
    }
  }

  .hero-blurb {
    max-width: 46ch;
    margin-top: var(--space-5);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-links {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-social {
    padding-left: var(--space-3);
    border-left: 1px solid var(--border);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 520;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .hero-link:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .hero-link[data-kind='text'] {
    padding-inline: 0.45rem;
    border-color: transparent;
    background: transparent;
  }

  .hero-link[data-kind='text']:hover {
    border-color: transparent;
    background: transparent;
  }

  .hero-link[data-kind='primary'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
  }

  .hero-link[data-kind='primary']:hover {
    border-color: var(--accent-hover);
    background: var(--accent-hover);
    color: var(--accent-contrast);
    box-shadow: var(--shadow-md);
  }

  .hero-link:active {
    opacity: 0.82;
    transform: translateY(0);
  }

  .hero-cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-8);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    transition: color var(--dur-fast) var(--ease);
  }

  .hero-cue:hover {
    color: var(--accent);
  }

  .hero-cue [data-icon] {
    animation: nudge 2.6s var(--ease-inout) infinite;
  }

  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: auto;
      padding-block: var(--space-7) var(--space-8);
    }

    .hero-inner {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero-portrait {
      justify-self: end;
      width: min(8rem, 34vw);
      margin-top: calc(-1 * var(--space-4));
    }

    .hero-cue {
      display: none;
    }

    .hero-role {
      min-height: 2.7em;
    }
  }

  @media (max-width: 40rem) {
    .hero {
      padding-bottom: var(--space-6);
    }

    .hero-portrait-desktop {
      display: none;
    }

    .hero-portrait-mobile {
      display: block;
      justify-self: auto;
      position: relative;
      width: clamp(10.5rem, 42vw, 11.75rem);
      height: clamp(10.25rem, 44vw, 10.75rem);
      margin-top: 0;
      margin-inline: auto;
    }

    .hero-portrait-frame {
      position: relative;
      z-index: 1;
      width: 100%;
      height: 100%;
      overflow: clip;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
    }

    .hero-portrait-mobile .hero-portrait-img {
      position: relative;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 12%;
      filter: none;
      transform: scale(1.1);
      transform-origin: center 12%;
    }
  }

  @media (max-width: 34rem) {
    .hero {
      padding-top: var(--space-6);
    }

    .hero-role {
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: -0.035em;
    }

    .typing.has-detail .typing-break {
      display: inline;
    }

    .hero-blurb {
      margin-top: var(--space-4);
      line-height: var(--leading-normal);
    }

    .hero-actions {
      display: grid;
      gap: var(--space-3);
      margin-top: var(--space-5);
    }

    .hero-primary {
      display: grid;
      grid-template-columns: repeat(3, max-content);
    }

    .hero-social {
      width: 100%;
      justify-content: center;
      padding-left: 0;
      border-left: 0;
    }

    .hero-link {
      min-height: 2.75rem;
      padding-inline: 0.75rem;
    }

    .hero-mobility {
      align-items: flex-start;
      max-width: none;
      font-size: var(--text-2xs);
      letter-spacing: 0;
      line-height: var(--leading-normal);
    }

    .hero-mobility-copy {
      display: grid;
    }

    .hero-mobility-separator {
      display: none;
    }
  }

  @media (max-width: 23.125rem) {
    .hero-primary {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-primary li:first-child {
      grid-column: 1 / -1;
    }

    .hero-primary .hero-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const typing = document.querySelector<HTMLElement>('[data-typing-text]');
  const leadOutput = typing?.querySelector<HTMLElement>('[data-typing-lead]');
  const detailOutput = typing?.querySelector<HTMLElement>('[data-typing-detail]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (typing && leadOutput && detailOutput) {
    const text = typing.dataset.typingText ?? '';
    const splitAt = text.indexOf(' — ');
    let timer: number | undefined;
    let index = 0;

    const render = (value: string) => {
      if (splitAt < 0) {
        leadOutput.textContent = value;
        detailOutput.textContent = '';
        typing.classList.remove('has-detail');
        return;
      }

      leadOutput.textContent = value.slice(0, Math.min(value.length, splitAt));
      const detail = value.length > splitAt + 1 ? value.slice(splitAt) : '';
      detailOutput.textContent = detail;
      typing.classList.toggle('has-detail', detail.length > 0);
    };

    const schedule = (callback: () => void, delay: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(callback, delay);
    };

    const step = () => {
      if (motion.matches) {
        render(text);
        return;
      }

      index += 1;
      render(text.slice(0, index));
      if (index < text.length) schedule(step, 55);
    };

    const start = () => {
      window.clearTimeout(timer);
      if (motion.matches) {
        index = text.length;
        render(text);
        return;
      }

      index = 0;
      render('');
      schedule(step, 250);
    };

    motion.addEventListener('change', start);
    start();
  }
</script>
