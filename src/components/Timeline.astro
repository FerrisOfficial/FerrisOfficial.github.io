---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import TimelineEntry from './TimelineEntry.astro';
import TimelineEnd from './TimelineEnd.astro';
import { compareTimelineNewest } from '../utils/timeline-sort';

const unsortedEntries = await getCollection('timeline');
const entries = unsortedEntries.sort(compareTimelineNewest);

const count = (category: string) =>
  category === 'all'
    ? entries.length
    : entries.filter((entry) => entry.data.category === category).length;

const filters = [
  { id: 'work', label: 'Work' },
  { id: 'all', label: 'All' },
  { id: 'project', label: 'Projects' },
  { id: 'education', label: 'Education' },
  { id: 'award', label: 'Awards' },
] as const;
---

<section class="section" id="timeline">
  <div class="container">
    <p class="section-label">Timeline</p>

    <h1 class="timeline-heading">Timeline: Experience, Education &amp; Projects</h1>
    <p class="timeline-lede">
      Production work is shown first. Switch to All for education, projects and awards,
      ordered by start date.
    </p>

    <div class="controls">
      <div class="filters" role="group" aria-label="Filter timeline by category">
        {
          filters.map((filter) => (
            <button
              class="filter"
              type="button"
              data-filter={filter.id}
              aria-pressed={filter.id === 'work' ? 'true' : 'false'}
            >
              {filter.label}
              <span class="filter-count mono">{count(filter.id)}</span>
            </button>
          ))
        }
      </div>

      <button class="sort-toggle" type="button" data-sort-toggle aria-pressed="true">
        <Icon name="lucide:arrow-up-down" width="14" height="14" aria-hidden="true" />
        <span data-sort-label>Newest first</span>
      </button>
    </div>

    <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>

    <div class="timeline" data-timeline>
      {/* The rail spans only the entries — past the last one it is the
          terminus's job to dissolve, so the solid spine must stop here. */}
      <div class="timeline-entries" data-timeline-entries>
        <div class="spine" aria-hidden="true">
          <span class="spine-track"></span>
          <span class="spine-progress" data-spine-progress></span>
        </div>

        <ol class="timeline-list" role="list">
          {entries.map((entry, index) => <TimelineEntry entry={entry} index={index} />)}
        </ol>
      </div>

      <TimelineEnd />
    </div>
  </div>
</section>

<style>
  .timeline-heading {
    font-size: var(--text-2xl);
  }

  .timeline-lede {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  /* --- Controls --- */

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .sort-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 520;
    white-space: nowrap;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .sort-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .sort-toggle[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .sort-toggle [data-icon] {
    transition: transform var(--dur) var(--ease);
  }

  .sort-toggle[aria-pressed='true'] [data-icon] {
    transform: rotate(180deg);
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 520;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .filter:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .filter[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-contrast);
  }

  .filter-count {
    font-size: var(--text-2xs);
    opacity: 0.65;
  }

  /* --- Rail --- */

  .timeline {
    /* --rail-x is the spine's centre, measured from the timeline's border box.
       --rail-pad is the gutter the cards are inset by. Markers live inside that
       padding, so they position themselves at (--rail-x - --rail-pad), which is
       negative — that is what puts them back on the rail instead of beside it. */
    --rail-x: 0.75rem;
    --rail-pad: 2.75rem;
    position: relative;
    margin-top: var(--space-7);
    padding-left: var(--rail-pad);
  }

  .timeline-entries {
    position: relative;
  }

  .spine {
    position: absolute;
    /* Same negative pull as the markers — see --rail-pad above. */
    left: calc(var(--rail-x) - var(--rail-pad) - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
  }

  .spine-track {
    position: absolute;
    inset: 0;
    border-radius: var(--r-full);
    background: var(--border);
    /* Softens both ends so the line does not begin or end abruptly. */
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 3rem,
      #000 calc(100% - 2rem),
      transparent 100%
    );
  }

  .spine-progress {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: var(--r-full);
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    will-change: transform;
    mask-image: linear-gradient(to bottom, transparent 0, #000 3rem);
  }

  .timeline-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 34rem) {
    .timeline {
      --rail-x: 0.5rem;
      --rail-pad: 1.75rem;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const timeline = document.querySelector<HTMLElement>('[data-timeline-entries]');
  const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-entry]'));
  const progress = document.querySelector<HTMLElement>('[data-spine-progress]');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  /* ---------- Accordion ---------- */

  function setEntryOpen(entry: HTMLElement, open: boolean) {
    const header = entry.querySelector<HTMLButtonElement>('.entry-toggle');
    if (!header) return;

    entry.classList.toggle('is-open', open);
    header.setAttribute('aria-expanded', String(open));

    const meta = entry.querySelector<HTMLElement>('.entry-meta');
    const summary = entry.querySelector<HTMLElement>('.entry-summary');
    const describedBy = [meta?.id, open ? undefined : summary?.id].filter(Boolean).join(' ');
    if (describedBy) header.setAttribute('aria-describedby', describedBy);
    else header.removeAttribute('aria-describedby');
  }

  for (const entry of entries) {
    const header = entry.querySelector<HTMLButtonElement>('.entry-toggle');
    if (!header) continue;

    header.addEventListener('click', () => {
      setEntryOpen(entry, !entry.classList.contains('is-open'));
    });
  }

  /* ---------- Filters ---------- */

  const labels: Record<string, string> = {
    work: 'work entries',
    education: 'education entries',
    project: 'projects',
    award: 'awards',
  };

  function applyFilter(active: string) {
    let shown = 0;

    for (const entry of entries) {
      const matches = active === 'all' || entry.dataset.category === active;
      if (matches) shown += 1;

      entry.hidden = !matches;
      // Collapse anything being filtered out, so it does not reappear expanded.
      if (!matches && entry.classList.contains('is-open')) {
        setEntryOpen(entry, false);
      }
    }

    for (const button of filters) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === active));
    }

    if (status) {
      status.textContent =
        active === 'all'
          ? `Showing all ${shown} entries.`
          : `Showing ${shown} ${labels[active] ?? 'entries'}.`;
    }
  }

  for (const button of filters) {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'));
  }

  /* ---------- Sort order ----------
     Reorders actual DOM nodes rather than using CSS `order`, so reading order
     and tab order keep matching what is on screen. */

  const list = document.querySelector<HTMLOListElement>('.timeline-list');
  const timelineRoot = document.querySelector<HTMLElement>('[data-timeline]');
  const entriesWrap = document.querySelector<HTMLElement>('[data-timeline-entries]');
  const terminus = document.querySelector<HTMLElement>('[data-terminus]');
  const sortToggle = document.querySelector<HTMLButtonElement>('[data-sort-toggle]');

  // Authored order is newest-first; keep a pristine copy to reverse from.
  const newestFirstOrder = entries.slice();

  function applyOrder(newestFirst: boolean) {
    if (!list || !timelineRoot || !entriesWrap || !terminus) return;

    const ordered = newestFirst ? newestFirstOrder : newestFirstOrder.slice().reverse();
    ordered.forEach((entry, position) => {
      entry.style.setProperty('--stagger', String(position));
      list.appendChild(entry); // appendChild moves the existing node
    });
    list.reversed = newestFirst;

    // Keep the conversion prompt after the evidence in either sort direction.
    // With newest-first as the default, current work must remain the first item.
    timelineRoot.appendChild(terminus);
    terminus.dataset.order = 'oldest';

    sortToggle?.setAttribute('aria-pressed', String(newestFirst));
    const sortLabel = sortToggle?.querySelector<HTMLElement>('[data-sort-label]');
    if (sortLabel) sortLabel.textContent = newestFirst ? 'Newest first' : 'Oldest first';
    if (status) {
      status.textContent = newestFirst
        ? 'Timeline sorted newest first.'
        : 'Timeline sorted oldest first.';
    }

    // Motion caches the scroll target's geometry; the terminus moving changes it.
    window.dispatchEvent(new Event('resize'));
  }

  sortToggle?.addEventListener('click', () => {
    const next = sortToggle.getAttribute('aria-pressed') !== 'true';
    applyOrder(next);

    // Reordering under the reader's feet is disorienting, so return them to the
    // top of the timeline to see the new order from its start.
    const heading = document.getElementById('timeline');
    heading?.scrollIntoView({
      behavior: reduceMotion.matches ? 'auto' : 'smooth',
      block: 'start',
    });
  });

  applyOrder(true);
  applyFilter('work');

  /* ---------- Entry reveals ----------
     Plain IntersectionObserver toggling a class; the movement itself is a CSS
     transition. No library involved, so a bundle failure can never leave the
     timeline stuck invisible. */

  const reveal = new IntersectionObserver(
    (observed) => {
      for (const item of observed) {
        if (!item.isIntersecting) continue;
        item.target.classList.add('is-visible');
        reveal.unobserve(item.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.08 },
  );

  for (const entry of entries) reveal.observe(entry);

  // Lights an entry's dot while it sits in the upper-middle band of the
  // viewport, roughly where the spine progress line has reached.
  const passed = new IntersectionObserver(
    (observed) => {
      for (const item of observed) {
        item.target.classList.toggle('is-passed', item.isIntersecting);
      }
    },
    { rootMargin: '-50% 0px -20% 0px', threshold: 0 },
  );

  for (const entry of entries) passed.observe(entry);

  /* ---------- Scroll-linked spine ----------
     The only part that needs Motion. Imported dynamically and guarded: if it
     fails, the spine just shows its static full-height state. */

  if (progress && timeline) {
    if (reduceMotion.matches) {
      progress.style.transform = 'scaleY(1)';
    } else {
      import('motion')
        .then(({ scroll }) => {
          scroll(
            (p: number) => {
              progress.style.transform = `scaleY(${p})`;
            },
            { target: timeline, offset: ['start 85%', 'end 50%'] },
          );
        })
        .catch(() => {
          progress.style.transform = 'scaleY(1)';
        });
    }
  }
</script>

<style is:global>
  /* Applied at first paint (.js is set by a blocking inline script), so entries
     never flash in at full opacity before the observer runs. */
  .js .entry {
    opacity: 0.55;
    transform: translateY(10px);
    transition:
      opacity 0.38s var(--ease),
      transform 0.38s var(--ease);
    transition-delay: calc(min(var(--stagger, 0), 3) * 25ms);
  }

  .js .entry.is-visible {
    opacity: 1;
    transform: none;
  }

  /* Without this, a reduced-motion visitor would see nothing at all: the global
     reduce rule kills the transition but not the opacity: 0 starting state. */
  @media (prefers-reduced-motion: reduce) {
    .js .entry {
      opacity: 1;
      transform: none;
      transition-delay: 0ms;
    }
  }
</style>
