---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CatanDemo from './CatanDemo.astro';
import { formatRange, isoDate } from '../utils/date';

interface Props {
  entry: CollectionEntry<'timeline'>;
  index: number;
}

const { entry, index } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const panelId = `panel-${entry.id}`;
const headerId = `header-${entry.id}`;

const categoryLabel: Record<typeof data.category, string> = {
  work: 'Work',
  education: 'Education',
  project: 'Project',
  award: 'Award',
};

const dateText = formatRange(data.startDate, data.endDate, data.ongoing);

/* The meter is the point: one segment per mark on the scale, each filled by
   however much of that mark was earned, so 4.6/5 draws four full bars and a
   partial fifth. That reads as "near the top" without knowing the scale at all,
   which the bare number never did. */
const { grade } = data;
const gradeSegments = grade
  ? Array.from({ length: grade.of }, (_, i) =>
      Math.round(Math.min(1, Math.max(0, grade.value - i)) * 100),
    )
  : [];
const gradeTip = 'Polish grading runs 2–5, where 5 is the top mark — read it as a GPA out of 5.';
/* "out of 5" already carries the scale, so the spoken version stays short —
   the tooltip's fuller wording would be read aloud on every single entry. */
const gradeSr = grade
  ? `Grade ${grade.value} out of ${grade.of}${grade.label ? ' (average)' : ''}.`
  : '';
---

<li
  class="entry"
  data-entry
  data-category={data.category}
  data-featured={data.featured ? '' : undefined}
  style={`--stagger: ${index}`}
>
  <span class="entry-dot" aria-hidden="true"></span>

  <div class="entry-card">
    <h3 class="entry-heading">
      <button
        class="entry-header"
        id={headerId}
        type="button"
        aria-expanded="false"
        aria-controls={panelId}
      >
        <span class="entry-meta">
          <time class="entry-date mono" datetime={isoDate(data.startDate)}>
            {data.dateApproximate && <span class="approx" title="Approximate date">~</span>}
            {dateText}
          </time>
          <span class="entry-chip">{categoryLabel[data.category]}</span>
          {
            grade && (
              <span class="entry-grade" data-tip={gradeTip}>
                <span class="grade-meter" aria-hidden="true">
                  {gradeSegments.map((fill) => (
                    <span class="grade-seg">
                      <span class="grade-seg-fill" style={`--fill: ${fill}%`} />
                    </span>
                  ))}
                </span>

                <span class="grade-value mono" aria-hidden="true">
                  {grade.value}
                  <span class="grade-of">/{grade.of}</span>
                  {grade.label && <span class="grade-of"> {grade.label}</span>}
                </span>

                {/* Hover can't reach a touch screen or a screen reader; the
                    badge itself still reads without it. */}
                <span class="visually-hidden">{gradeSr}</span>
              </span>
            )
          }
        </span>

        <span class="entry-title">
          {data.title}
          {data.org && <span class="entry-org">{data.org}</span>}
        </span>

        <span class="entry-summary">{data.summary}</span>

        <span class="entry-chevron" aria-hidden="true">
          <Icon name="lucide:chevron-down" width="17" height="17" />
        </span>
      </button>
    </h3>

    <div class="entry-panel" id={panelId} role="region" aria-labelledby={headerId}>
      <div class="entry-panel-inner">
        <div class="entry-body">
          <Content />
        </div>

        {data.demo === 'catan' && <CatanDemo />}

        {
          data.tech.length > 0 && (
            <ul class="entry-tech" role="list">
              {data.tech.map((item) => (
                <li class="tag">{item}</li>
              ))}
            </ul>
          )
        }

        {
          data.links.length > 0 && (
            <div class="entry-links">
              {data.links.map((link) => (
                <a class="link" href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}
                  <Icon name="lucide:arrow-up-right" width="14" height="14" aria-hidden="true" />
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </div>
</li>

<style>
  /* Each entry exposes its category colour as --cat / --cat-soft, so every
     rule below styles against one pair rather than four sets of variants. */
  .entry[data-category='work'] {
    --cat: var(--cat-work);
    --cat-soft: var(--cat-work-soft);
  }

  .entry[data-category='education'] {
    --cat: var(--cat-education);
    --cat-soft: var(--cat-education-soft);
  }

  .entry[data-category='project'] {
    --cat: var(--cat-project);
    --cat-soft: var(--cat-project-soft);
  }

  .entry[data-category='award'] {
    --cat: var(--cat-award);
    --cat-soft: var(--cat-award-soft);
  }

  .entry {
    position: relative;
    padding-bottom: var(--space-5);
  }

  .entry:last-child {
    padding-bottom: 0;
  }

  /* --- Marker on the spine --- */

  .entry-dot {
    position: absolute;
    /* Negative: pulls the dot back out of the card gutter onto the spine. */
    left: calc(var(--rail-x) - var(--rail-pad) - 0.375rem);
    top: 1.55rem;
    width: 0.75rem;
    height: 0.75rem;
    border: 2px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
    z-index: 1;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .entry[data-featured] .entry-dot {
    width: 0.9rem;
    height: 0.9rem;
    left: calc(var(--rail-x) - var(--rail-pad) - 0.45rem);
    top: 1.48rem;
  }

  /* Lit once the scroll progress line has reached it. */
  .entry.is-passed .entry-dot {
    border-color: var(--cat);
    background: var(--cat);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--cat) 16%, transparent);
  }

  .entry:hover .entry-dot,
  .entry.is-open .entry-dot {
    transform: scale(1.25);
  }

  /* --- Card --- */

  .entry-card {
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    overflow: hidden;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .entry:hover .entry-card {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .entry.is-open .entry-card {
    border-color: color-mix(in srgb, var(--cat) 45%, var(--border));
    box-shadow: var(--shadow-md);
  }

  .entry-heading {
    margin: 0;
    font: inherit;
    letter-spacing: normal;
  }

  .entry-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-4);
    width: 100%;
    padding: var(--space-5);
    text-align: left;
  }

  .entry-meta {
    grid-column: 1;
    /* Positioned so the grade tooltip can anchor to the whole row rather than
       to the badge. Anchored to the badge it ran past the card's right edge and
       .entry-card's overflow clip cut it in half. */
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .entry-date {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }

  .approx {
    color: var(--text-faint);
    cursor: help;
  }

  .entry-chip {
    padding: 0.15em 0.55em;
    border-radius: var(--r-sm);
    background: var(--cat-soft);
    color: var(--cat);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* Neutral, not tied to category colour, so it reads as a fact rather than
     competing with the category chip for attention. */
  .entry-grade {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2em 0.5em;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    cursor: help;
  }

  .grade-meter {
    display: flex;
    gap: 2px;
  }

  .grade-seg {
    width: 0.5rem;
    height: 0.3rem;
    border-radius: 1px;
    background: var(--border-strong);
    overflow: hidden;
  }

  .grade-seg-fill {
    display: block;
    width: var(--fill);
    height: 100%;
    background: var(--cat);
  }

  .grade-value {
    font-size: var(--text-2xs);
    font-weight: 600;
    color: var(--text);
  }

  .grade-of {
    color: var(--text-faint);
    font-weight: 500;
  }

  /* Below the row, never above it: .entry-card clips overflow and the row sits
     at the card's top edge. Anchored to .entry-meta with left:0 + a 100% cap, so
     it starts at the card's content edge and can never exceed its width. */
  .entry-grade::after {
    content: attr(data-tip);
    position: absolute;
    top: calc(100% + 0.45rem);
    left: 0;
    z-index: 5;
    width: max-content;
    max-width: min(22rem, 100%);
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--bg-subtle);
    box-shadow: var(--shadow-md);
    color: var(--text-muted);
    font-size: var(--text-2xs);
    font-weight: 500;
    line-height: var(--leading-normal);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-3px);
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      visibility 0s linear var(--dur-fast);
  }

  .entry-grade:hover::after {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .entry-title {
    grid-column: 1;
    display: block;
    margin-top: var(--space-1);
    font-size: var(--text-lg);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: var(--text);
  }

  .entry-org {
    color: var(--text-muted);
    font-weight: 500;
  }

  .entry-org::before {
    content: ' · ';
    color: var(--text-faint);
  }

  .entry-summary {
    grid-column: 1;
    display: block;
    max-width: 58ch;
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .entry-chevron {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: var(--r-full);
    background: var(--bg-subtle);
    color: var(--text-faint);
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .entry-header:hover .entry-chevron {
    background: var(--cat-soft);
    color: var(--cat);
  }

  .entry.is-open .entry-chevron {
    transform: rotate(180deg);
    background: var(--cat-soft);
    color: var(--cat);
  }

  /* --- Expanding panel ---
     grid-template-rows 0fr→1fr animates to auto height with no JS measurement.
     Without JS the panel simply stays open, so content is never trapped. */

  .entry-panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  :global(.js) .entry-panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-slow) var(--ease);
  }

  :global(.js) .entry.is-open .entry-panel {
    grid-template-rows: 1fr;
  }

  .entry-panel-inner {
    overflow: hidden;
  }

  /* Keeps collapsed content out of the tab order and the a11y tree.
     Delayed so it does not vanish before the collapse finishes. */
  :global(.js) .entry-panel-inner {
    visibility: hidden;
    transition: visibility 0s linear var(--dur-slow);
  }

  :global(.js) .entry.is-open .entry-panel-inner {
    visibility: visible;
    transition-delay: 0s;
  }

  .entry-body {
    margin-inline: var(--space-5);
    padding-block: var(--space-4);
    border-top: 1px solid var(--border);
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* Direct children only, so every top-level block (p, ul, blockquote) gets
     separated without also spacing out the list items inside them. */
  .entry-body > :global(* + *) {
    margin-top: var(--space-3);
  }

  .entry-body :global(ul) {
    padding-left: 1.1rem;
  }

  .entry-body :global(li) {
    margin-top: var(--space-1);
  }

  .entry-body :global(li)::marker {
    color: var(--cat);
  }

  .entry-body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .entry-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 var(--space-5) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .entry-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0 var(--space-5) var(--space-5);
  }

  .entry-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-sm);
  }

  @media (max-width: 34rem) {
    .entry-header {
      padding: var(--space-4);
      gap: var(--space-2);
    }

    .entry-body {
      margin-inline: var(--space-4);
      padding-bottom: var(--space-3);
    }

    .entry-tech,
    .entry-links {
      margin-inline: var(--space-4);
      margin-bottom: var(--space-4);
    }

    .entry-chevron {
      width: 1.6rem;
      height: 1.6rem;
    }
  }
</style>
