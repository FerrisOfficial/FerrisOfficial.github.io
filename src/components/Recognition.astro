---
import { Icon } from 'astro-icon/components';
---

<section class="section recognition" aria-labelledby="recognition-heading">
  <div class="container">
    <h2 id="recognition-heading">Selected achievements</h2>

    <div class="recognition-list">
      <article class="recognition-item">
        <span class="recognition-icon" aria-hidden="true">
          <Icon name="lucide:award" width="19" height="19" />
        </span>
        <div class="recognition-copy">
          <p class="recognition-kicker mono">Academic distinction</p>
          <h3>Rector’s Scholarship for Academic Achievement · 2023/24</h3>
          <p>
            Awarded for academic results achieved in 2022/23. GPA 4.74/5.00;
            ranked 11th of 160 in the first-cycle Computer Science scholarship ranking.
          </p>
        </div>
      </article>

      <article class="recognition-item">
        <span class="recognition-icon" aria-hidden="true">
          <Icon name="lucide:code-xml" width="19" height="19" />
        </span>
        <div class="recognition-copy">
          <p class="recognition-kicker mono">Programming competition</p>
          <h3>
            <a
              href="https://oi.edu.pl/l/29oi_1etap_wyroznieni/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Honorable Mention — First Stage, 29th Polish Olympiad in Informatics
              <span aria-hidden="true">↗</span>
            </a>
          </h3>
          <p>
            Recognised in the first stage of Poland’s national informatics competition.
          </p>
        </div>
      </article>
    </div>

    <div class="additional-training">
      <span class="training-icon" aria-hidden="true">
        <Icon name="lucide:badge-check" width="18" height="18" />
      </span>
      <div class="additional-training-copy">
        <p class="additional-training-label mono">Additional training</p>
        <h3>
          <a
            href="https://pl.linkedin.com/posts/10xdevs-pl_zapisy-na-10xdevs-30-oficjalnie-otwarte-activity-7416735807404855296-yDfO"
            target="_blank"
            rel="noopener noreferrer"
          >
            10xDevs 3.0 · 2026 <span aria-hidden="true">↗</span>
          </a>
        </h3>
        <p>
          Practical programme covering agent-assisted software development, testing and
          workflow automation.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .recognition {
    padding-top: 0;
  }

  .recognition h2 {
    font-size: var(--text-xl);
  }

  .recognition-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .recognition-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .recognition-icon,
  .training-icon {
    display: grid;
    place-items: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: var(--r-md);
  }

  .recognition-icon {
    background: var(--cat-award-soft);
    color: var(--cat-award);
  }

  .recognition-kicker,
  .additional-training-label {
    font-size: var(--text-2xs);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .recognition-kicker {
    color: var(--cat-award);
  }

  .recognition-item h3 {
    margin-top: var(--space-2);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .recognition-item h3 a:hover {
    color: var(--accent);
  }

  .recognition-item p {
    max-width: 52ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .additional-training {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
  }

  .training-icon {
    background: var(--accent-soft);
    color: var(--accent);
  }

  .additional-training-label {
    color: var(--accent);
  }

  .additional-training-copy h3 {
    margin-top: var(--space-1);
    font-size: var(--text-base);
    line-height: var(--leading-snug);
  }

  .additional-training-copy h3 a:hover {
    color: var(--accent);
  }

  .additional-training-copy p {
    max-width: 64ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (max-width: 42rem) {
    .recognition-list {
      grid-template-columns: 1fr;
    }

    .recognition-item,
    .additional-training {
      padding: var(--space-4);
    }
  }
</style>
