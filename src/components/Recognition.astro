---
import { Icon } from 'astro-icon/components';
---

<section class="section recognition" aria-labelledby="recognition-heading">
  <div class="container">
    <p class="section-label">Recognition</p>
    <h2 id="recognition-heading">Selected achievements</h2>

    <div class="recognition-list">
      <article class="recognition-item">
        <Icon name="lucide:award" width="19" height="19" aria-hidden="true" />
        <div>
          <h3>Rector’s Scholarship for Academic Achievement · 2023/24</h3>
          <p>
            Awarded for academic results achieved in 2022/23. GPA 4.74/5.00;
            ranked 11th of 160 in the first-cycle Computer Science scholarship ranking.
          </p>
        </div>
      </article>

      <article class="recognition-item">
        <Icon name="lucide:code-xml" width="19" height="19" aria-hidden="true" />
        <div>
          <h3>
            <a
              href="https://oi.edu.pl/l/29oi_1etap_wyroznieni/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Honorable Mention — First Stage, 29th Polish Olympiad in Informatics
              <span aria-hidden="true">↗</span>
            </a>
          </h3>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .recognition {
    padding-top: 0;
  }

  .recognition h2 {
    font-size: var(--text-xl);
  }

  .recognition-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .recognition-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .recognition-item > [data-icon] {
    flex-shrink: 0;
    color: var(--cat-award);
  }

  .recognition-item h3 {
    font-size: var(--text-base);
  }

  .recognition-item h3 a:hover {
    color: var(--accent);
  }

  .recognition-item p {
    max-width: 52ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  @media (max-width: 42rem) {
    .recognition-list {
      grid-template-columns: 1fr;
    }
  }
</style>
