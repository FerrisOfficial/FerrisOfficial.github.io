---
import { Icon } from 'astro-icon/components';

const interests = [
  { label: 'Sailing', icon: 'lucide:sailboat' },
  { label: 'Cooking', icon: 'lucide:cooking-pot' },
  { label: 'Strategy games', icon: 'lucide:dices' },
];
---

<section class="section about" id="about">
  <div class="container about-inner">
    <div class="about-aside" aria-label="Interests outside engineering">
      <p class="about-aside-label mono">Beyond the terminal</p>
      <ul class="interest-list" role="list">
        {
          interests.map((interest) => (
            <li>
              <span class="interest-icon">
                <Icon name={interest.icon} width="17" height="17" aria-hidden="true" />
              </span>
              {interest.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about-text">
      <p class="section-label">About</p>

      <h2 class="about-heading">Off the clock</h2>

      <p class="about-body">
        I like systems where the constraints are real — memory, latency, correctness —
        and I like the discipline that comes with getting them right. That mindset carries
        over outside of work too: sailing and cooking both reward the same patience and
        attention to detail, and I'm a sucker for a good board game, Catan especially
        (which is, in part, why I ended up building an AI to play it).
      </p>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }

  .about-aside {
    width: min(17rem, 100%);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-md);
  }

  .about-aside-label {
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .interest-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .interest-list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 560;
  }

  .interest-icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .about-text {
    min-width: 0;
  }

  .about-heading {
    font-size: var(--text-2xl);
  }

  .about-body {
    max-width: var(--measure);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  @media (max-width: 48rem) {
    .about-inner {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .about-aside {
      width: min(24rem, 100%);
      text-align: left;
    }
  }
</style>
