---
import ThemeToggle from './ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
import { site } from '../site';

// The portfolio is a single page. The helper keeps section links useful if a
// standalone route is added later.
const isHome = Astro.url.pathname === '/';
const homeAnchor = (hash: string) => (isHome ? hash : `/${hash}`);

const links = [
  { label: 'Experience', href: homeAnchor('#experience') },
  { label: 'Recommendations', href: homeAnchor('#recommendations') },
  { label: 'Projects', href: homeAnchor('#featured-work') },
  { label: 'Skills', href: homeAnchor('#skills') },
  { label: 'About', href: homeAnchor('#about') },
  { label: 'Contact', href: homeAnchor('#contact') },
];

const brandHref = isHome ? '#top' : '/';
---

<header class="nav" id="nav">
  <div class="nav-inner container">
    <a
      class="brand"
      href={brandHref}
      aria-label={isHome ? `${site.name} - back to top` : `${site.name} - home`}
    >
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <path class="brand-mark-stroke" d="M6.5 25V7.5L16 17.25 25.5 7.5V25" />
        <path class="brand-mark-accent" d="M6.5 7.5 10 11.1" />
      </svg>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="nav-links" id="primary-navigation" aria-label="Sections">
      {
        links.map((link) => {
          // Only same-page anchors get scroll-spied. Plain routes are marked
          // current once at build time.
          const hash = link.href.includes('#') ? link.href.slice(link.href.indexOf('#')) : undefined;
          const isCurrentPage = !hash && Astro.url.pathname === link.href;
          return (
            <a
              class={`nav-link${isCurrentPage ? ' is-active' : ''}`}
              href={link.href}
              data-nav-link={hash}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <button
      class="nav-menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-controls="primary-navigation"
      aria-expanded="false"
    >
      <Icon class="menu-icon menu-icon-open" name="lucide:menu" width="19" height="19" aria-hidden="true" />
      <Icon class="menu-icon menu-icon-close" name="lucide:x" width="19" height="19" aria-hidden="true" />
    </button>

    <ThemeToggle />
  </div>

  <div class="nav-backdrop" data-nav-backdrop aria-hidden="true"></div>

  {/* Scroll position, as a hairline under the bar. */}
  <div class="scroll-progress" aria-hidden="true"><span id="scroll-progress-bar"></span></div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  /* The border only appears once the page has moved, so the hero stays clean. */
  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 4rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .brand-mark {
    width: 1.8rem;
    height: 1.8rem;
    flex: 0 0 auto;
    overflow: visible;
    transition: transform var(--dur) var(--ease);
  }

  .brand-mark-stroke,
  .brand-mark-accent {
    fill: none;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .brand-mark-stroke {
    stroke: var(--text);
    stroke-width: 2.65;
  }

  .brand-mark-accent {
    stroke: var(--accent);
    stroke-width: 2.65;
  }

  .brand:hover .brand-mark {
    transform: translateY(-1px);
  }

  .brand-name {
    font-size: var(--text-sm);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav-menu-toggle {
    display: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text-muted);
  }

  .menu-icon-close {
    display: none;
  }

  .nav-link {
    position: relative;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--r-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    bottom: 0.3rem;
    height: 1.5px;
    border-radius: var(--r-full);
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .nav-link.is-active {
    color: var(--text);
  }

  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .scroll-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }

  .scroll-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    will-change: transform;
  }

  .nav-backdrop {
    display: none;
  }

  @media (max-width: 48rem) {
    .nav-inner {
      position: relative;
      z-index: 2;
    }

    .nav-menu-toggle {
      display: grid;
    }

    .nav-links {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: var(--space-5);
      right: var(--space-5);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-1);
      padding: var(--space-2);
      border: 1px solid var(--border);
      border-radius: var(--r-lg);
      background: var(--bg);
      box-shadow: var(--shadow-lg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem) scale(0.98);
      transform-origin: top;
      transition:
        opacity var(--dur-fast) var(--ease),
        visibility var(--dur-fast) var(--ease),
        transform var(--dur-fast) var(--ease);
    }

    .nav-backdrop {
      position: fixed;
      inset: 4rem 0 0;
      z-index: 1;
      display: block;
      background: rgb(0 0 0 / 0.3);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .nav-link {
      padding: var(--space-3);
    }

    .nav-link::after {
      left: var(--space-3);
      right: auto;
      width: 1.5rem;
    }

    .nav.menu-open .nav-links {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav.menu-open .nav-backdrop {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .nav.menu-open .menu-icon-open {
      display: none;
    }

    .nav.menu-open .menu-icon-close {
      display: block;
    }
  }

  @media (max-width: 34rem) {
    .brand {
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-left: -0.425rem;
      justify-content: center;
    }

    .brand-name {
      display: none;
    }

    .nav-inner {
      gap: var(--space-3);
    }

    .nav-link {
      padding-inline: var(--space-2);
    }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const bar = document.getElementById('scroll-progress-bar');
  const menuToggle = document.querySelector<HTMLButtonElement>('.nav-menu-toggle');
  const menuBackdrop = document.querySelector<HTMLElement>('[data-nav-backdrop]');
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'),
  );
  const sections = navLinks
    .map((link) => document.querySelector(link.dataset.navLink ?? ''))
    .filter((el): el is HTMLElement => el instanceof HTMLElement);
  const firstSection = sections[0];

  function setActiveNav(id: string | null) {
    for (const link of navLinks) {
      const active = id !== null && link.dataset.navLink === id;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  // --- Scroll progress + nav border ---
  let ticking = false;

  function onScroll() {
    if (ticking) return;
    ticking = true;

    requestAnimationFrame(() => {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
      if (bar) bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      nav?.classList.toggle('is-scrolled', window.scrollY > 8);
      if (firstSection && window.scrollY + window.innerHeight * 0.5 < firstSection.offsetTop) {
        setActiveNav(null);
      }
      ticking = false;
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  function closeMenu() {
    nav?.classList.remove('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Open navigation');
  }

  menuToggle?.addEventListener('click', () => {
    const open = !nav?.classList.contains('menu-open');
    nav?.classList.toggle('menu-open', open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
  });

  menuBackdrop?.addEventListener('click', closeMenu);

  for (const link of navLinks) link.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  document.addEventListener('click', (event) => {
    if (nav?.classList.contains('menu-open') && !nav.contains(event.target as Node)) closeMenu();
  });

  // --- Scroll spy ---
  // Sections are tall, so track which one occupies the middle band of the
  // viewport rather than whichever merely intersects it.
  if (sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = `#${entry.target.id}`;
          setActiveNav(id);
        }
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );

    for (const section of sections) spy.observe(section);
  }
</script>
