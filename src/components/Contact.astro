---
import { Icon } from 'astro-icon/components';
import { site, contactLinks } from '../site';
---

<section class="section contact" id="contact">
  <div class="container">
    <p class="section-label">Contact</p>

    <div class="contact-layout">
      <div class="contact-intro">
        <h2 class="contact-heading">Let's talk</h2>
        <p class="contact-text">
          Open to roles in systems and performance-critical C++, and to research-adjacent
          work in applied machine learning. Happy to hear about anything interesting.
        </p>
      </div>

      <ul class="contact-list" role="list">
        {
          contactLinks.map((link) => {
            const external = !link.href.startsWith('mailto:');
            return (
              <li>
                <a
                  class="contact-item"
                  href={link.href}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener noreferrer' : undefined}
                >
                  <span class="contact-icon">
                    <Icon name={link.icon} width="18" height="18" aria-hidden="true" />
                  </span>
                  <span class="contact-detail">
                    <span class="contact-label mono">{link.label}</span>
                    <span class="contact-value">{link.value}</span>
                  </span>
                  <Icon
                    class="contact-arrow"
                    name="lucide:arrow-up-right"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  />
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <p class="mono">© {new Date().getFullYear()} {site.name}</p>
    <p class="mono footer-built">Built with Astro · no trackers, no cookies</p>
  </div>
</footer>

<style>
  .contact {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
  }

  .contact-heading {
    font-size: var(--text-2xl);
  }

  .contact-text {
    max-width: 40ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .contact-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    transition:
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .contact-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .contact-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .contact-label {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .contact-value {
    font-size: var(--text-sm);
    font-weight: 520;
    overflow-wrap: anywhere;
  }

  .contact-arrow {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--text-faint);
    transition:
      transform var(--dur) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .contact-item:hover .contact-arrow {
    color: var(--accent);
    transform: translate(2px, -2px);
  }

  /* --- Footer --- */

  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-2xs);
    color: var(--text-faint);
  }

  @media (max-width: 48rem) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
