---
import { Icon } from 'astro-icon/components';
import { site } from '../site';
---

<section class="section contact" id="contact">
  <div class="container">
    <p class="section-label">Contact</p>

    <h2 class="contact-heading">Have an interesting problem?</h2>
    <p class="contact-text">
      I'm interested in backend and systems engineering roles where performance,
      correctness and scale matter.
    </p>

    <div class="contact-actions">
      <a class="contact-primary" href={`mailto:${site.email}`}>
        <Icon name="lucide:mail" width="17" height="17" aria-hidden="true" />
        Email me
      </a>

      <a class="contact-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:linkedin" width="16" height="16" aria-hidden="true" />
        LinkedIn
      </a>

      <a class="contact-secondary" href={site.github} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:github" width="16" height="16" aria-hidden="true" />
        GitHub
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <p class="mono">© {new Date().getFullYear()} {site.name}</p>
    <p class="mono footer-built">Built with Astro · no trackers, no cookies</p>
  </div>
</footer>

<style>
  .contact {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .contact-heading {
    max-width: 30ch;
    font-size: var(--text-2xl);
  }

  .contact-text {
    max-width: 44ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.3rem;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 560;
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .contact-primary:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .contact-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text-muted);
    font-weight: 520;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .contact-secondary:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  /* --- Footer --- */

  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    padding-block: var(--space-5);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--text-2xs);
    color: var(--text-faint);
  }
</style>
