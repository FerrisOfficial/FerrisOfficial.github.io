---
import { Icon } from 'astro-icon/components';
import { site } from '../site';
import Footer from './Footer.astro';
---

<section class="section contact" id="contact">
  <div class="container contact-inner">
    <p class="section-label">Contact</p>

    <div class="contact-copy">
      <h2 class="contact-heading">Hiring for a technically demanding software role?</h2>
      <p class="contact-text">
        I'm interested in backend, systems and applied-ML roles where performance,
        reliability or correctness are first-class constraints.
      </p>
      <a class="contact-email mono" href={`mailto:${site.email}`}>{site.email}</a>
    </div>

    <div class="contact-actions">
      <a class="contact-primary" href={`mailto:${site.email}`}>
        <Icon name="lucide:mail" width="17" height="17" aria-hidden="true" />
        Email Maciej
      </a>

      <a class="contact-secondary" href={site.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:linkedin" width="16" height="16" aria-hidden="true" />
        LinkedIn
      </a>

      <a class="contact-secondary" href={site.github} target="_blank" rel="noopener noreferrer">
        <Icon name="lucide:github" width="16" height="16" aria-hidden="true" />
        GitHub
      </a>
    </div>
  </div>
</section>

<Footer />

<style>
  .contact {
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .contact-heading {
    max-width: 30ch;
    font-size: var(--text-2xl);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--space-6) var(--space-8);
  }

  .contact-inner .section-label {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .contact-text {
    max-width: 44ch;
    margin-top: var(--space-4);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .contact-email {
    display: inline-block;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  .contact-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.3rem;
    border-radius: var(--r-md);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 560;
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .contact-primary:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .contact-secondary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text-muted);
    font-weight: 520;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .contact-secondary:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .contact-primary:active,
  .contact-secondary:active {
    opacity: 0.82;
    transform: translateY(0);
  }

  @media (max-width: 48rem) {
    .contact-inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-5);
    }

    .contact-inner .section-label {
      grid-column: auto;
    }

    .contact-actions {
      justify-content: flex-start;
    }
  }
</style>
