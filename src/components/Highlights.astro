---
import { getCollection } from 'astro:content';
import { formatRange } from '../utils/date';

const featured = (await getCollection('timeline'))
  .filter((entry) => entry.data.featured && entry.data.category === 'work')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const symfonia = featured.find((entry) => entry.id === '2026-05-symfonia-ksef');
const nokiaInternship = featured.find((entry) => entry.id === '2025-07-nokia-internship');
const nokiaContract = featured.find((entry) => entry.id === '2025-10-nokia-cpp-developer');

const symfoniaEvidence = [
  {
    label: 'KSeF backend services',
    copy: 'Build and debug C#/.NET and GraphQL services for KSeF, Poland’s national e-invoicing platform, using SQL, Hangfire, Dapr, Kubernetes and OPA-based authorization.',
  },
  {
    label: 'API 2.0 migration',
    copy: 'Contributed across endpoints, data models, authentication, persistence, GraphQL schemas, Ministry of Finance integration logic and automated tests.',
  },
  {
    label: 'Production investigation',
    copy: 'Trace production failures across service layers and build test harnesses, repository documentation and automated validation workflows.',
  },
];

const nokiaEvidence = [
  {
    label: '5G control logic',
    copy: 'Developed C++20 logic for temperature-aware cell activation, traffic management and energy management in 5G base stations.',
  },
  {
    label: 'Massive MIMO',
    copy: 'Extended operator-configuration handling for Massive MIMO and beamforming functionality.',
  },
  {
    label: 'Verification',
    copy: 'Added automated tests, validated changes in simulation, and debugged with GDB and Valgrind in the team’s production workflow.',
  },
];
---

<section class="section experience" id="experience" aria-labelledby="experience-heading">
  <div class="container experience-inner">
    <h2 id="experience-heading">Production experience</h2>

    <div class="experience-list">
      {
        symfonia && (
          <article class="experience-entry">
            <header class="experience-meta">
              <p class="company">Symfonia</p>
              <h3>{symfonia.data.title}</h3>
              <p class="date mono">
                {formatRange(symfonia.data.startDate, symfonia.data.endDate, symfonia.data.ongoing)}
              </p>
              <p class="experience-lead">Backend services for Poland’s national e-invoicing platform.</p>
            </header>
            <div class="experience-evidence">
              {symfoniaEvidence.map((item, index) => (
                <details
                  class="evidence-row evidence-disclosure"
                  data-mobile-collapse
                  data-mobile-featured={index === 0 ? true : undefined}
                  open
                >
                  <summary>{item.label}</summary>
                  <p>{item.copy}</p>
                </details>
              ))}
            </div>
          </article>
        )
      }

      {
        nokiaInternship && nokiaContract && (
          <article class="experience-entry">
            <header class="experience-meta">
              <p class="company">Nokia · 5G RAN</p>
              <div class="role-history">
                <p class="experience-lead experience-lead-highlight">
                  Internship → extended C++ contract after three months
                </p>
                <p>
                  <strong>C++ Software Engineer</strong>
                  <span>Contract · October 2025–April 2026</span>
                </p>
                <p>
                  <strong>C++ Summer Trainee</strong>
                  <span>Internship · July 2025–October 2025</span>
                </p>
              </div>
            </header>
            <div class="experience-evidence">
              {nokiaEvidence.map((item, index) => (
                <details
                  class="evidence-row evidence-disclosure"
                  data-mobile-collapse
                  data-mobile-featured={index === 0 ? true : undefined}
                  open
                >
                  <summary>{item.label}</summary>
                  <p>{item.copy}</p>
                </details>
              ))}
            </div>
          </article>
        )
      }
    </div>

  </div>
</section>

<style>
  .experience-inner {
    max-width: var(--container);
  }

  .experience h2 {
    font-size: var(--text-2xl);
  }

  .experience-list {
    margin-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .experience-entry {
    display: grid;
    grid-template-columns: minmax(18.75rem, 0.38fr) minmax(0, 0.62fr);
    gap: var(--space-7);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .experience-meta {
    align-self: start;
    padding-block: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid color-mix(in srgb, var(--cat-work) 72%, var(--border));
  }

  .company {
    color: var(--cat-work);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .experience-meta h3 {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 680;
    line-height: var(--leading-tight);
  }

  .date {
    margin-top: var(--space-3);
    color: var(--text-faint);
    font-size: var(--text-xs);
  }

  .experience-lead {
    max-width: 31ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .experience-lead-highlight {
    margin-top: 0;
    color: var(--accent);
    font-weight: 650;
  }

  .role-history {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .role-history p {
    display: grid;
    gap: var(--space-1);
  }

  .role-history strong {
    font-size: var(--text-lg);
    font-weight: 680;
    line-height: var(--leading-tight);
  }

  .role-history span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .experience-evidence {
    display: grid;
    margin: 0;
  }

  .evidence-row {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .evidence-row:first-child {
    padding-top: var(--space-2);
  }

  .evidence-row:last-child {
    padding-bottom: var(--space-2);
    border-bottom: 0;
  }

  .evidence-row h4,
  .evidence-disclosure summary {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 680;
  }

  .evidence-row > p {
    max-width: 64ch;
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .evidence-disclosure summary {
    list-style: none;
  }

  .evidence-disclosure summary::marker {
    content: '';
  }

  .evidence-disclosure summary::-webkit-details-marker {
    display: none;
  }

  @media (max-width: 40rem) {
    .evidence-disclosure summary {
      display: flex;
      min-height: 2.75rem;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
      cursor: pointer;
    }

    .evidence-disclosure summary::after {
      content: '+';
      color: var(--text-faint);
      font-family: var(--font-mono);
      font-size: var(--text-base);
      font-weight: 500;
    }

    .evidence-disclosure[open] summary::after {
      content: '−';
    }

  }

  @media (max-width: 46rem) {
    .experience-entry {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-5);
    }

    .experience-meta {
      padding-block: var(--space-1);
    }

    .evidence-row:first-child {
      padding-top: 0;
    }
  }
</style>

<script>
  const mobileEvidence = window.matchMedia('(max-width: 40rem)');
  const mobileDisclosures = document.querySelectorAll<HTMLDetailsElement>('[data-mobile-collapse]');

  const syncMobileEvidence = () => {
    for (const disclosure of mobileDisclosures) {
      disclosure.open = !mobileEvidence.matches || disclosure.hasAttribute('data-mobile-featured');
    }
  };

  mobileEvidence.addEventListener('change', syncMobileEvidence);
  syncMobileEvidence();
</script>
