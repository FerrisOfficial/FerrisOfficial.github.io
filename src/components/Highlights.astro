---
import { getCollection } from 'astro:content';
import { formatRange } from '../utils/date';

const featured = (await getCollection('timeline'))
  .filter((entry) => entry.data.featured && entry.data.category === 'work')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const symfonia = featured.find((entry) => entry.id === '2026-05-symfonia-ksef');
const nokiaInternship = featured.find((entry) => entry.id === '2025-07-nokia-internship');
const nokiaContract = featured.find((entry) => entry.id === '2025-10-nokia-cpp-developer');

const symfoniaEvidence = [
  {
    label: 'Backend services',
    copy: 'Develop and debug C#/.NET and GraphQL services using SQL, Hangfire, Dapr, Kubernetes and OPA-based authorization.',
  },
  {
    label: 'KSeF migration',
    copy: 'Contributed to the KSeF API 1.0-to-2.0 migration across endpoints, data models, authentication, persistence, GraphQL and automated tests.',
  },
  {
    label: 'Production and tooling',
    copy: 'Investigate production failures and created repository documentation, validation harnesses and a Graphify knowledge graph used by the team with Claude.',
  },
];

const nokiaEvidence = [
  {
    label: '5G control logic',
    copy: 'Developed C++20 logic for temperature-aware cell activation, traffic management and energy management in 5G base stations.',
  },
  {
    label: 'Massive MIMO',
    copy: 'Extended operator-configuration handling for Massive MIMO and beamforming functionality.',
  },
  {
    label: 'Verification',
    copy: 'Added automated tests, validated changes in simulation, and debugged with GDB and Valgrind before being selected to continue after the internship.',
  },
];
---

<section class="section experience" id="experience" aria-labelledby="experience-heading">
  <div class="container experience-inner">
    <p class="section-label">Experience</p>
    <h2 id="experience-heading">Production experience</h2>

    <div class="experience-list">
      {
        symfonia && (
          <article class="experience-entry">
            <header class="experience-meta">
              <p class="company">Symfonia</p>
              <h3>{symfonia.data.title}</h3>
              <p class="date mono">
                {formatRange(symfonia.data.startDate, symfonia.data.endDate, symfonia.data.ongoing)}
              </p>
            </header>
            <dl class="experience-evidence">
              {symfoniaEvidence.map((item) => (
                <div class="evidence-row">
                  <dt>{item.label}</dt>
                  <dd>{item.copy}</dd>
                </div>
              ))}
            </dl>
          </article>
        )
      }

      {
        nokiaInternship && nokiaContract && (
          <article class="experience-entry">
            <header class="experience-meta">
              <p class="company">Nokia · 5G RAN</p>
              <div class="role-history">
                <p>
                  <strong>C++ Software Engineering</strong>
                  <span>Contract · October 2025–April 2026</span>
                </p>
                <p>
                  <strong>C++ Summer Trainee</strong>
                  <span>Internship · July 2025–October 2025</span>
                </p>
              </div>
            </header>
            <dl class="experience-evidence">
              {nokiaEvidence.map((item) => (
                <div class="evidence-row">
                  <dt>{item.label}</dt>
                  <dd>{item.copy}</dd>
                </div>
              ))}
            </dl>
          </article>
        )
      }
    </div>

    <a class="timeline-link" href="/timeline">
      View full experience timeline <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .experience-inner {
    max-width: var(--container);
  }

  .experience h2 {
    font-size: var(--text-2xl);
  }

  .experience-list {
    margin-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  .experience-entry {
    display: grid;
    grid-template-columns: minmax(18.75rem, 0.38fr) minmax(0, 0.62fr);
    gap: var(--space-7);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--border);
  }

  .experience-meta {
    align-self: start;
    padding-block: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid color-mix(in srgb, var(--cat-work) 72%, var(--border));
  }

  .company {
    color: var(--cat-work);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .experience-meta h3 {
    margin-top: var(--space-3);
    font-size: var(--text-xl);
    font-weight: 680;
    line-height: var(--leading-tight);
  }

  .date {
    margin-top: var(--space-3);
    color: var(--text-faint);
    font-size: var(--text-xs);
  }

  .role-history {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .role-history p {
    display: grid;
    gap: var(--space-1);
  }

  .role-history strong {
    font-size: var(--text-lg);
    font-weight: 680;
    line-height: var(--leading-tight);
  }

  .role-history span {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .experience-evidence {
    display: grid;
    margin: 0;
  }

  .evidence-row {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .evidence-row:first-child {
    padding-top: var(--space-2);
  }

  .evidence-row:last-child {
    padding-bottom: var(--space-2);
    border-bottom: 0;
  }

  .evidence-row dt {
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 680;
  }

  .evidence-row dd {
    max-width: 64ch;
    margin-top: var(--space-1);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .timeline-link {
    display: inline-flex;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .timeline-link:hover {
    color: var(--accent-hover);
    transform: translateX(2px);
  }

  @media (max-width: 46rem) {
    .experience-entry {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding-block: var(--space-5);
    }

    .experience-meta {
      padding-block: var(--space-1);
    }

    .evidence-row:first-child {
      padding-top: 0;
    }
  }
</style>
