---
import { getCollection } from 'astro:content';
import { formatYear } from '../utils/date';

const featured = (await getCollection('timeline'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const experience = featured.filter((entry) => entry.data.category === 'work');
const education = featured.filter((entry) => entry.data.category === 'education');

function yearRange({ startDate, endDate, ongoing }: { startDate: Date; endDate?: Date; ongoing: boolean }) {
  const from = formatYear(startDate);
  if (ongoing) return `${from} — Present`;
  if (!endDate) return from;
  const to = formatYear(endDate);
  return from === to ? from : `${from} — ${to}`;
}
---

<section class="section highlights" id="experience">
  <div class="container">
    <p class="section-label">Selected impact</p>

    <h2 class="highlights-heading">Production experience</h2>
    <p class="highlights-lede">
      Recent production work across regulated .NET services and performance-sensitive
      C++ systems, alongside a strong computer science foundation.
    </p>

    <div class="highlights-grid">
      <div class="highlights-group">
        <h3 class="group-heading">Experience</h3>
        <ul class="highlight-list" role="list">
          {
            experience.map((entry) => (
              <li class="highlight-card" data-category="work">
                <span class="highlight-date mono">{yearRange(entry.data)}</span>
                <span class="highlight-title">
                  {entry.data.title}
                  {entry.data.org && <span class="highlight-org">{entry.data.org}</span>}
                </span>
                <span class="highlight-summary">{entry.data.summary}</span>
              </li>
            ))
          }
        </ul>

      </div>

      <div class="highlights-group">
        <h3 class="group-heading">Education</h3>
        <ul class="highlight-list" role="list">
          {
            education.map((entry) => (
              <li class="highlight-card" data-category="education">
                <span class="highlight-date mono">
                  {yearRange(entry.data)}
                  {entry.data.grade && (
                    <>
                      {' · '}
                      {entry.data.grade.value}/{entry.data.grade.of}
                      {entry.data.grade.label && ` ${entry.data.grade.label}`}
                    </>
                  )}
                </span>
                <span class="highlight-title">
                  {entry.data.title}
                  {entry.data.org && <span class="highlight-org">{entry.data.org}</span>}
                </span>
                <span class="highlight-summary">{entry.data.summary}</span>
              </li>
            ))
          }
        </ul>

        <aside class="timeline-cta" aria-labelledby="timeline-cta-heading">
          <h4 class="timeline-cta-heading" id="timeline-cta-heading">Want the full story?</h4>
          <p class="timeline-cta-text">
            Explore my complete timeline of work, education, projects and achievements.
          </p>
          <a class="timeline-cta-link" href="/timeline">
            View full timeline <span aria-hidden="true">→</span>
          </a>
        </aside>
      </div>
    </div>
  </div>
</section>

<style>
  .highlights-heading {
    font-size: var(--text-2xl);
  }

  .highlights-lede {
    max-width: 52ch;
    margin-top: var(--space-3);
    color: var(--text-muted);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .group-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .highlight-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .highlight-card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--cat);
    border-radius: var(--r-md);
    background: var(--surface);
    transition:
      border-color var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .highlight-card[data-category='work'] {
    --cat: var(--cat-work);
  }

  .highlight-card[data-category='education'] {
    --cat: var(--cat-education);
  }

  .highlight-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .highlight-date {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-faint);
  }

  .highlight-title {
    font-size: var(--text-base);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
  }

  .highlight-org {
    color: var(--text-muted);
    font-weight: 500;
  }

  .highlight-org::before {
    content: ' · ';
    color: var(--text-faint);
  }

  .highlight-summary {
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-muted);
  }

  .timeline-cta {
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .timeline-cta-heading {
    font-size: var(--text-sm);
    font-weight: 620;
    letter-spacing: var(--tracking-tight);
  }

  .timeline-cta-text {
    max-width: 40ch;
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .timeline-cta-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    border-radius: var(--r-sm);
    color: var(--accent);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .timeline-cta-link:hover {
    color: var(--accent-hover);
    transform: translateX(2px);
  }

  .timeline-cta-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  @media (max-width: 48rem) {
    .highlights-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
