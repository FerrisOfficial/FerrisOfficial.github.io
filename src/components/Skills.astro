---
import { Icon } from 'astro-icon/components';

const groups = [
  {
    label: 'Core',
    tone: 'work',
    items: ['C++20', 'Python', 'C# / .NET'],
  },
  {
    label: 'Backend',
    tone: 'project',
    items: ['GraphQL', 'REST APIs', 'SQL', 'Hangfire', 'Dapr', 'OPA'],
  },
  {
    label: 'Systems and tooling',
    tone: 'education',
    items: ['Concurrency', 'Subprocess management', 'Linux', 'GDB', 'Valgrind', 'Git', 'Gerrit'],
  },
  {
    label: 'Testing and delivery',
    tone: 'award',
    items: ['Automated testing', 'GoogleTest', 'xUnit', 'CI', 'Docker', 'Kubernetes'],
  },
  {
    label: 'AI-native & ML',
    tone: 'ml',
    wide: true,
    items: [
      'PyTorch',
      'Game AI',
      'AI-native development',
      'Coding agents',
      'Context engineering',
      'LLM evaluation',
    ],
  },
] as const;
---

<section class="section skills" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading">Technical strengths</h2>

    <div class="skills-grid">
      {
        groups.map((group) => (
          <section class="skill-group" data-tone={group.tone} data-wide={'wide' in group ? true : undefined}>
            <h3 class="mono">{group.label}</h3>
            <ul role="list">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        ))
      }
    </div>

    <div class="spoken-inline">
      <span class="spoken-title mono">
        <Icon name="lucide:languages" width="16" height="16" aria-hidden="true" />
        Languages
      </span>
      <p><strong>Polish</strong> · Native</p>
      <p><strong>English</strong> · Cambridge C1 Advanced, Grade B · 198/210</p>
    </div>
  </div>
</section>

<style>
  .skills h2 {
    font-size: var(--text-2xl);
  }

  @media (min-width: 40.01rem) {
    .skills {
      padding-top: var(--space-8);
    }
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5) var(--space-7);
    margin-top: var(--space-6);
  }

  .skill-group {
    padding-top: var(--space-4);
    border-top: 2px solid var(--cat);
  }

  .skill-group[data-tone='work'] {
    --cat: var(--cat-work);
  }

  .skill-group[data-tone='project'] {
    --cat: var(--cat-project);
  }

  .skill-group[data-tone='education'] {
    --cat: var(--cat-education);
  }

  .skill-group[data-tone='award'] {
    --cat: var(--cat-award);
  }

  .skill-group[data-tone='ml'] {
    --cat: var(--cat-project);
  }

  .skill-group[data-wide] {
    grid-column: 1 / -1;
  }

  .skill-group h3 {
    color: var(--cat);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .skill-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .skill-group li {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .spoken-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--text-sm);
  }

  .spoken-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-faint);
    font-size: var(--text-2xs);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .spoken-inline strong {
    color: var(--text);
  }

  @media (max-width: 42rem) {
    .skills-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .skill-group li {
      font-size: var(--text-xs);
    }

    .skill-group[data-wide] {
      grid-column: auto;
    }

    .spoken-inline {
      display: grid;
      gap: var(--space-2);
    }
  }
</style>
