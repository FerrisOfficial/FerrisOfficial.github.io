---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CatanDemo from './CatanDemo.astro';

const entries = await getCollection('timeline');
const project = entries.find((entry) => entry.id === '2026-01-catan-engine');
if (!project) throw new Error('Featured project entry not found: 2026-01-catan-engine');

const github = project.data.links.find((link) => /github\.com/i.test(link.url));
const thesis = project.data.links.find((link) => /thesis/i.test(link.label));
const deepDive = github ? `${github.url}#design` : undefined;

---

<section
  class="section featured"
  id="featured-work"
  style="--cat: var(--cat-project); --cat-soft: var(--cat-project-soft);"
>
  <div class="container">
    <article class="featured-project">
      <div class="featured-heading">
        <h2>Two-Player Catan Simulation Engine &amp; Game AI</h2>
        <p class="authorship mono">
          Co-authored with Yaryna Rachkevych{' '}<span aria-hidden="true">·</span>{' '}BSc thesis{' '}
          <span aria-hidden="true">·</span>{' '}University of Wrocław
        </p>
      </div>

      <p class="featured-summary">
        A C++20 simulation platform for a reproducible two-player Catan variant. It runs
        seeded tournaments between deterministic heuristics, chance-aware alpha-beta and
        agents tuned through evolutionary search.
      </p>

      <div class="engineering-scope">
        <p class="engineering-scope-label mono">My engineering contribution</p>
        <ul>
          <li>Designed the bit-packed board state and fast apply/undo transitions.</li>
          <li>Implemented deterministic seeding, replay inspection and multi-agent benchmarks.</li>
          <li>Profiled and optimized the engine, then built cross-compiler tests and CI.</li>
        </ul>
      </div>

      <dl class="metric-highlights">
        <div>
          <dt>59%</dt>
          <dd>
            Lower per-game cost after profiling and optimization. A representative native
            Clang 22 <code>-O3</code> build reaches 250-300 random-vs-random games per second.
          </dd>
        </div>
        <div>
          <dt>&lt;800 B</dt>
          <dd>
            Fixed board state using bit-packed objects, with fast apply/undo evaluation and
            no complete-board copies.
          </dd>
        </div>
        <div>
          <dt>3 compilers</dt>
          <dd>
            242 generated test cases across six binaries, verified with GCC, MSVC, Clang
            and AddressSanitizer CI.
          </dd>
        </div>
      </dl>

      <div class="featured-footer">
        <ul class="featured-tags" role="list" aria-label="Catan technologies">
          <li class="tag">C++20</li>
          <li class="tag">WebAssembly</li>
        </ul>

        <div class="featured-actions">
          <div class="button-actions">
            <a class="featured-link featured-link-primary" href="#catan-demo">
              <Icon name="lucide:play" width="15" height="15" aria-hidden="true" />
              Run live demo
            </a>
            {
              github && (
                <a class="featured-link" href={github.url} target="_blank" rel="noopener noreferrer">
                  <Icon name="lucide:github" width="15" height="15" aria-hidden="true" />
                  Repository
                </a>
              )
            }
          </div>
          <div class="text-actions">
            {thesis && <a href={thesis.url} target="_blank" rel="noopener noreferrer">Thesis ↗</a>}
            {deepDive && <a href={deepDive} target="_blank" rel="noopener noreferrer">Engineering deep dive ↗</a>}
          </div>
        </div>
      </div>

      <div id="catan-demo">
        <CatanDemo />
      </div>
    </article>
  </div>
</section>

<style>
  .featured {
    padding-bottom: var(--space-7);
  }

  .featured-project {
    margin-top: 0;
  }

  .featured-heading {
    display: grid;
    gap: var(--space-2);
  }

  .featured-heading h2 {
    font-size: var(--text-2xl);
  }

  .authorship {
    color: var(--text-faint);
    font-size: var(--text-xs);
  }

  .featured-summary {
    max-width: 78ch;
    margin-top: var(--space-5);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
  }

  .engineering-scope {
    display: grid;
    grid-template-columns: minmax(10rem, 0.28fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-left: 2px solid var(--cat);
    background: color-mix(in srgb, var(--cat-soft) 42%, transparent);
  }

  .engineering-scope-label {
    color: var(--cat);
    font-size: var(--text-2xs);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .engineering-scope ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: var(--space-5);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .engineering-scope li::marker {
    color: var(--cat);
  }

  .metric-highlights {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .metric-highlights > div {
    padding-top: var(--space-4);
    border-top: 2px solid color-mix(in srgb, var(--cat) 50%, var(--border));
  }

  .metric-highlights dt {
    color: var(--cat);
    font-size: var(--text-2xl);
    font-weight: 720;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .metric-highlights dd {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .metric-highlights code {
    color: var(--text);
    font-size: 0.92em;
  }

  .featured-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }

  .featured-tags,
  .button-actions,
  .text-actions,
  .featured-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .featured-tags {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .featured-tags .tag {
    border-color: color-mix(in srgb, var(--cat) 35%, var(--border));
    color: var(--cat);
  }

  .featured-actions {
    gap: var(--space-4);
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }

  .featured-link:hover {
    color: var(--cat);
    border-color: var(--cat);
    background: var(--cat-soft);
  }

  .featured-link-primary {
    border-color: var(--cat);
    background: var(--cat);
    color: var(--bg);
  }

  .featured-link-primary:hover {
    color: var(--bg);
    opacity: 0.9;
  }

  .featured-link:active,
  .text-actions a:active {
    opacity: 0.78;
  }

  .text-actions {
    gap: var(--space-3);
  }

  .text-actions a {
    color: var(--text-faint);
    font-size: var(--text-xs);
  }

  .text-actions a:hover {
    color: var(--cat);
  }

  #catan-demo {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  #catan-demo :global(.demo) {
    margin: 0;
  }

  @media (max-width: 48rem) {
    .featured-footer {
      display: grid;
    }

    .metric-highlights {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .engineering-scope {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .featured-actions {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 34rem) {
    .featured {
      padding-bottom: 3.5rem;
    }

    .featured-heading h2 {
      font-size: var(--text-xl);
    }

    .featured-summary {
      line-height: var(--leading-normal);
    }

    .featured-footer {
      gap: var(--space-4);
    }

    .button-actions {
      flex-wrap: wrap;
    }

    .featured-link,
    .text-actions a {
      min-height: 2.75rem;
    }

    .text-actions a {
      display: inline-flex;
      align-items: center;
    }
  }
</style>
