---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import CatanDemo from './CatanDemo.astro';

const entries = await getCollection('timeline');
const project = entries.find((entry) => entry.id === '2026-01-catan-engine');
if (!project) throw new Error('Featured project entry not found: 2026-01-catan-engine');

const github = project.data.links.find((link) => /github\.com/i.test(link.url));
const thesis = project.data.links.find((link) => /thesis/i.test(link.label));
const deepDive = github ? `${github.url}#design` : undefined;

const tags = ['13 full-engine agents', '11 browser agents', 'C++20', 'WebAssembly'];
---

<section
  class="section featured"
  id="featured-work"
  style="--cat: var(--cat-project); --cat-soft: var(--cat-project-soft);"
>
  <div class="container">
    <p class="section-label">Featured work</p>

    <div class="featured-card">
      <div class="featured-intro">
        <h2 class="featured-title">{project.data.title.replace(' Simulation Platform', '')}</h2>
        <p class="featured-subtitle">
          Two-player Catan research engine + multi-agent benchmark platform
        </p>
        <p class="featured-desc">
          A deliberately modified 1v1 research variant: two players race to 15 victory points,
          with bank and port trading but no player-to-player negotiation. The full native engine
          contains 13 agents; 11 are available in the browser demo below.
        </p>

        <dl class="case-study">
          <div>
            <dt>Authorship</dt>
            <dd>Co-authored as a BSc thesis with Yaryna Rachkevych at the University of Wrocław.</dd>
          </div>
          <div>
            <dt>State model</dt>
            <dd>Bit-packed objects keep the fixed board state under 800 bytes, with deterministic seeds and replay logs.</dd>
          </div>
          <div>
            <dt>Engineering</dt>
            <dd>C++20 was chosen for allocation control, profiling and fast apply/undo evaluation without copying boards.</dd>
          </div>
          <div>
            <dt>Measured result</dt>
            <dd>Profiling cut per-game cost by 59%; Clang 22 -O3 reaches 250–300 games/s for random vs random.</dd>
          </div>
          <div>
            <dt>Agents</dt>
            <dd>Random, iterative and specialised heuristics, chance-aware alpha-beta, and an evolutionarily tuned agent.</dd>
          </div>
          <div>
            <dt>Verification</dt>
            <dd>111 test definitions expand to 242 cases across six binaries, with GCC, MSVC, Clang and ASan CI.</dd>
          </div>
        </dl>

        <ul class="featured-tags" role="list">
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>

        <div class="featured-actions">
          <a class="featured-link featured-link-primary" href="#catan-demo">
            <Icon name="lucide:play" width="15" height="15" aria-hidden="true" />
            Live Demo
          </a>
          {
            github && (
              <a class="featured-link" href={github.url} target="_blank" rel="noopener noreferrer">
                <Icon name="lucide:github" width="15" height="15" aria-hidden="true" />
                Repository
              </a>
            )
          }
          {
            thesis && (
              <a class="featured-link" href={thesis.url} target="_blank" rel="noopener noreferrer">
                <Icon name="lucide:book-open" width="15" height="15" aria-hidden="true" />
                Thesis
              </a>
            )
          }
          {
            deepDive && (
              <a class="featured-link" href={deepDive} target="_blank" rel="noopener noreferrer">
                <Icon name="lucide:code-xml" width="15" height="15" aria-hidden="true" />
                Engineering deep dive
              </a>
            )
          }
        </div>
      </div>

      <div id="catan-demo">
        <CatanDemo />
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding-bottom: var(--space-7);
  }

  .featured-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .featured-title {
    font-size: var(--text-2xl);
  }

  .featured-subtitle {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--cat);
  }

  .featured-desc {
    max-width: var(--measure);
    margin-top: var(--space-4);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  .case-study {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .case-study > div {
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
  }

  .case-study dt {
    color: var(--cat);
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .case-study dd {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }

  .featured-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .featured-tags .tag {
    border-color: color-mix(in srgb, var(--cat) 35%, var(--border));
    color: var(--cat);
  }

  .featured-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.55rem 1.05rem;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--bg-subtle);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 550;
    transition:
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }

  .featured-link:hover {
    color: var(--cat);
    border-color: var(--cat);
    background: var(--cat-soft);
    transform: translateY(-2px);
  }

  .featured-link-primary {
    border-color: var(--cat);
    background: var(--cat);
    color: var(--bg);
  }

  .featured-link-primary:hover {
    color: var(--bg);
    background: var(--cat);
    opacity: 0.9;
  }

  #catan-demo {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }

  /* CatanDemo's own margins assume it's nested inside a narrower timeline
     entry panel; here it already sits inside .featured-card's padding. */
  #catan-demo :global(.demo) {
    margin: 0;
  }

  @media (max-width: 34rem) {
    .featured {
      padding-bottom: var(--space-6);
    }

    .featured-card {
      padding: var(--space-4);
    }

    .featured-subtitle {
      font-size: var(--text-base);
      line-height: var(--leading-snug);
    }

    .featured-desc {
      margin-top: var(--space-3);
      line-height: var(--leading-normal);
    }

    .case-study {
      grid-template-columns: 1fr;
      margin-top: var(--space-4);
    }

    .featured-tags {
      margin-top: var(--space-4);
    }

    .featured-actions {
      margin-top: var(--space-5);
    }

    #catan-demo {
      margin-top: var(--space-5);
      padding-top: var(--space-5);
    }
  }
</style>
